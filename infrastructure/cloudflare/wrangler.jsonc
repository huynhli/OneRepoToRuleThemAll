{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "liam-portfolio-searchme",
  "main": "worker.js",
  "compatibility_date": "2026-11-14",
  "assets": {
    "directory": "../../dist",
    "binding": "ASSETS",
    "not_found_handling": "none",
    "run_worker_first": ["/api/*", "/work/*", "/search/*", "/projects/*"]
  },
  "vars": {}
}
